# Backend FastAPI + Management gRPC 환경변수 템플릿
# 실제 값은 .env.local 에 작성 (.gitignore 가 .env*.local 차단).
# 팀장에게 RDS 비밀번호와 엔드포인트를 받아주세요.

# AWS RDS Casting (활성 DB) — sslrootcert 는 절대 경로
DATABASE_URL="postgresql+psycopg://postgres:<PASSWORD>@<RDS_ENDPOINT>:5432/Casting?sslmode=verify-full&sslrootcert=/absolute/path/to/global-bundle.pem"

# ─────────────────────────────────────────────────────────────
# DB 스키마 — 사용자별 격리
# ─────────────────────────────────────────────────────────────
# RDS Casting DB 는 사용자별 격리 스키마를 운영합니다. 다음 3 환경변수가 모두 같은 값을
# 가리켜야 ORM / scripts / e2e watcher 가 동일 스키마를 사용합니다.
#
#   smartcast — 공유 통합 스키마 (운영/공통 작업)
#   inbean    — kiminbean 전용
#   yejin     — yejin 전용
#   <본인 ID> — 새 사용자는 본인 스키마를 RDS 에 생성 후 master 시드 적용
#
# 가이드: docs/db_event_bridge/MULTI_SCHEMA_SETUP.md
SMARTCAST_SCHEMA=smartcast
DB_SCHEMA=smartcast
PG_SCHEMA=smartcast

# (선택) APP_ENV 가 development 일 때만 /api/debug/* endpoint 활성화
APP_ENV=development

# (선택) Mgmt gRPC ROS2 어댑터 — Mgmt 서버 별도 기동 시 1
MGMT_ROS2_ENABLED=0

# (선택) Interface ↔ Management proxy — V6 Phase C-2 호환 모드
INTERFACE_PROXY_START_PRODUCTION=0

# ─────────────────────────────────────────────────────────────
# DB row trigger event bridge (SPEC: docs/db_event_bridge/SPEC.md)
# ─────────────────────────────────────────────────────────────
# 기본 off — 머지 후에도 동작 변경 없음. 운영 활성화 시 둘 다 1로.
# 활성화 전 본인 스키마에 trigger 마이그레이션 적용 필수:
#   docs/db_event_bridge/MULTI_SCHEMA_SETUP.md §3
MGMT_DB_EVENT_BRIDGE_ENABLED=0
MGMT_DB_EVENT_TASK_DISPATCH=0
